# KalaSetu AI local configuration template
# Copy this file to .env for backend development. Commit this template only.
# Values below are non-secret development defaults; replace every CHANGE_ME value locally.

# Application
APP_NAME=KalaSetu API
APP_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
PUBLIC_API_BASE_URL=http://localhost:8000
PUBLIC_SHARE_WEB_BASE_URL=http://localhost:3000

# Browser access
# Use a JSON array. Native Flutter apps do not use CORS, but Flutter web does.
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# Frontend reference
# Flutter does not automatically read this file. Pass these values with --dart-define:
# flutter run --dart-define=API_BASE_URL=http://10.0.2.2:8000/api/v1 --dart-define=USE_MOCK_API=false
# Android emulator: 10.0.2.2; iOS simulator: 127.0.0.1; physical phone: Mac LAN IP.
FLUTTER_API_BASE_URL=http://10.0.2.2:8000/api/v1
FLUTTER_USE_MOCK_API=true

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/kalasetu
DATABASE_ECHO=false
DATABASE_AUTO_CREATE=false

# Authentication
JWT_SECRET=CHANGE_ME_USE_AT_LEAST_32_RANDOM_CHARACTERS
JWT_ALGORITHM=HS256
JWT_EXPIRES_SECONDS=86400
OTP_EXPIRES_SECONDS=300
OTP_RETRY_AFTER_SECONDS=30
OTP_MAX_REQUESTS_PER_15_MINUTES=5
OTP_IDEMPOTENCY_TTL_SECONDS=60
# Development only. The backend must reject this setting outside development/test.
DEV_OTP=123456

# Retry safety
IDEMPOTENCY_TTL_SECONDS=86400

# Media
MEDIA_STORAGE=local
MEDIA_LOCAL_DIR=./media
# Local-development URL base. Production draft media must use private/signed access.
MEDIA_URL_BASE=http://localhost:8000/media
MAX_IMAGE_BYTES=10485760
MAX_IMAGE_PIXELS=25000000
MAX_AUDIO_BYTES=26214400
MAX_AUDIO_DURATION_SECONDS=120
MEDIA_CONSENT_POLICY_VERSION=2026-08-29

# AI orchestration
# Keep mock mode for the first integrated flow; switch providers one at a time.
AI_MODE=mock
AI_OPERATION_POLL_AFTER_SECONDS=2
AI_PROVIDER_TIMEOUT_SECONDS=45
IMAGE_ENHANCEMENT_PROVIDER=mock
SPEECH_PROVIDER=faster_whisper
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=4
WHISPER_MODEL_CACHE_DIR=./models/faster-whisper
TRANSLATION_PROVIDER=mock
CATALOGUE_GENERATION_PROVIDER=mock

# LLM - required only when catalogue generation provider is llm.
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Demo data
SEED_DEMO_DATA=true
PRICING_BENCHMARK_MODE=demo
